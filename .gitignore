node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store
*.log
.egressa-cache/
packages/*/kb/

# Agent session transcripts dumped into the repo root: YYYY-MM-DD-HHMMSS-slug.txt
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-*.txt

# gstack tool artifacts (biome honours .gitignore via vcs.useIgnoreFile)
.gstack/

# Local skill install: a symlink into skill/ so /privacy-review resolves in this
# checkout. Not committed -- symlinks are unreliable on the Windows CI leg.
.claude/skills/

# Agent worktrees: a throwaway checkout per subagent run, each on its own branch.
# They hold a full copy of the tree, so an unguarded `git add -A` from the repo
# root would otherwise commit the repository into itself.
.claude/worktrees/

# Generated reports (make-pdf output and similar)
/REPORT.pdf
/*.pdf
