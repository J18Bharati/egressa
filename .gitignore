node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store
*.log
.egressa-cache/
packages/*/kb/

# Agent session transcripts dumped into the repo root: YYYY-MM-DD-HHMMSS-slug.txt
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-*.txt

# gstack tool artifacts (biome honours .gitignore via vcs.useIgnoreFile)
.gstack/

# Local skill install: a symlink into skill/ so /privacy-review resolves in this
# checkout. Not committed -- symlinks are unreliable on the Windows CI leg.
.claude/skills/

# Agent worktrees: a throwaway checkout per subagent run, each on its own branch.
# They hold a full copy of the tree, so an unguarded `git add -A` from the repo
# root would otherwise commit the repository into itself.
.claude/worktrees/

# Generated reports (make-pdf output and similar)
/REPORT.pdf
/*.pdf

# Field-test output: scans run against real third-party repositories, kept so
# recall and false-positive counts can be diffed across releases. Each run holds
# file paths, dependency lists and call sites from a private codebase, so these
# are never committed -- only the defects they surface are.
/test-runs/

# Licence files copied into each package by scripts/copy-kb.mjs (prepack and build)
packages/*/LICENSE
packages/*/NOTICE

# Confidential working material: field-test triage written against private
# codebases, and the internal design record (customer names, pricing). Kept
# locally under private/ and scrubbed from history; never committed.
/private/
docs/reviews/*
docs/designs/*

# Output of the nightly link check, regenerated each run.
/link-report.md
