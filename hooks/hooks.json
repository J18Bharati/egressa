{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/tracker-write-check.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking for tracker and storage writes"
          }
        ]
      }
    ]
  }
}
