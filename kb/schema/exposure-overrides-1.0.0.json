{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adequacy.dev/schemas/exposure-overrides-1.0.0.json",
  "title": "Exposure overrides",
  "description": "The only place a human judgment about exposure may be recorded. Every override requires a rationale and an author, and is versioned separately from the factual entries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rulesVersion", "overrides"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "rulesVersion": { "type": "string" },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vendorId", "level", "rationale", "author", "addedAt"],
        "properties": {
          "vendorId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "level": { "enum": ["none", "low", "moderate", "elevated"] },
          "rationale": { "type": "string", "minLength": 20 },
          "author": { "type": "string" },
          "addedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
