{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adequacy.dev/schemas/vendor-1.0.0.json",
  "title": "Adequacy vendor knowledge base entry",
  "description": "Factual, sourced record of one vendor. Entries state facts and cite them. Anything evaluative belongs in ratings/exposure-overrides.json, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "category",
    "homepage",
    "aliases",
    "processing",
    "legal",
    "dataCategories",
    "sources",
    "lastVerified"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 64 },
    "name": { "type": "string", "minLength": 1, "description": "Legal entity name where known." },
    "product": { "type": "string" },
    "category": {
      "enum": [
        "analytics",
        "error-tracking",
        "apm",
        "session-replay",
        "email",
        "sms",
        "crm",
        "marketing",
        "payments",
        "identity",
        "ai",
        "search",
        "media",
        "hosting",
        "database",
        "support",
        "other"
      ]
    },
    "homepage": { "type": "string", "pattern": "^https://" },
    "aliases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packages", "hosts"],
      "properties": {
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "description": "Keyed by ecosystem so a new language is a data addition, not a schema change.",
          "properties": {
            "npm": { "type": "array", "items": { "$ref": "#/$defs/packageAlias" } },
            "pypi": { "type": "array", "items": { "$ref": "#/$defs/packageAlias" } }
          }
        },
        "hosts": { "type": "array", "items": { "$ref": "#/$defs/hostAlias" } },
        "clientConstructors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["module"],
            "properties": {
              "module": { "type": "string" },
              "export": { "type": "string" },
              "hostOption": { "oneOf": [{ "type": "null" }, { "type": "string" }] }
            }
          }
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jurisdictions", "euRegion"],
      "properties": {
        "jurisdictions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["country", "role"],
            "properties": {
              "country": { "type": "string", "pattern": "^([A-Z]{2}|EEA)$" },
              "role": { "enum": ["primary", "support", "backup", "cdn"] },
              "note": { "type": "string" }
            }
          }
        },
        "euRegion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available"],
          "properties": {
            "available": { "type": "boolean" },
            "scope": {
              "enum": ["full", "partial", "product-specific"],
              "description": "Required when available is true. EU regions are usually partial; a bare boolean overstates coverage."
            },
            "docUrl": { "type": "string", "pattern": "^https://" },
            "notes": { "type": "string" }
          },
          "if": { "properties": { "available": { "const": true } } },
          "then": { "required": ["available", "scope", "docUrl"] }
        }
      }
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dpa", "transferMechanisms"],
      "properties": {
        "dpa": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available"],
          "properties": {
            "available": { "type": "boolean" },
            "url": { "type": "string", "pattern": "^https://" },
            "type": {
              "enum": ["click-through", "incorporated-by-reference", "negotiated", "unknown"]
            },
            "lastChecked": { "$ref": "#/$defs/isoDate" }
          },
          "if": { "properties": { "available": { "const": true } } },
          "then": { "required": ["available", "url"] }
        },
        "subprocessors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "listType": { "enum": ["page", "pdf", "json", "unknown"] },
            "notifications": { "enum": ["email-subscribe", "rss", "page-only", "none", "unknown"] }
          }
        },
        "transferMechanisms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mechanism"],
            "properties": {
              "mechanism": { "enum": ["DPF", "SCC", "BCR", "adequacy", "derogation", "none"] },
              "dpfCertified": { "type": "boolean" },
              "url": { "type": "string", "pattern": "^https://" },
              "lastChecked": { "$ref": "#/$defs/isoDate" }
            }
          }
        }
      }
    },
    "dataCategories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "typical"],
        "properties": {
          "category": {
            "enum": [
              "email",
              "name",
              "ip_address",
              "device_id",
              "cookie_id",
              "user_id",
              "location",
              "payment_data",
              "phone",
              "content",
              "prompt_content",
              "usage_telemetry",
              "stack_traces",
              "session_recording"
            ]
          },
          "typical": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "title", "publisher", "accessedAt"],
        "properties": {
          "url": { "type": "string", "pattern": "^https://" },
          "title": { "type": "string" },
          "publisher": { "enum": ["vendor", "regulator", "other"] },
          "accessedAt": { "$ref": "#/$defs/isoDate" }
        }
      }
    },
    "lastVerified": { "$ref": "#/$defs/isoDate" },
    "verifiedBy": { "type": "string" },
    "disputed": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["issueUrl", "raisedAt", "summary"],
          "properties": {
            "issueUrl": { "type": "string", "pattern": "^https://" },
            "raisedAt": { "$ref": "#/$defs/isoDate" },
            "summary": { "type": "string" }
          }
        }
      ]
    },
    "notes": { "type": "string", "description": "Neutral, factual prose only. No adjectives." }
  },
  "$defs": {
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "packageAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["official-sdk", "wrapper", "plugin", "framework-integration"] },
        "detectTransitive": { "type": "boolean", "default": false }
      }
    },
    "hostAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "match", "purpose"],
      "properties": {
        "pattern": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" },
        "match": { "enum": ["exact", "suffix"] },
        "purpose": { "enum": ["api", "browser-sdk", "ingest", "cdn", "auth", "other"] },
        "note": { "type": "string" }
      }
    }
  }
}
