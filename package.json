{
  "name": "adequacy-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --pretty",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "kb:validate": "tsx packages/kb-loader/scripts/validate.ts",
    "kb:coverage": "tsx packages/kb-loader/scripts/coverage.ts",
    "schema:check": "tsx scripts/check-schemas.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm schema:check && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
