{
  "name": "egressa",
  "version": "0.2.0",
  "description": "Detects third-party data-egress patterns in source code and their cross-border transfer exposure.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/J18Bharati/egressa.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/J18Bharati/egressa#readme",
  "bugs": {
    "url": "https://github.com/J18Bharati/egressa/issues"
  },
  "keywords": [
    "gdpr",
    "privacy",
    "data-protection",
    "data-transfer",
    "cross-border",
    "static-analysis",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "egressa": "./dist/cli.js"
  },
  "files": ["dist", "!dist/**/*.map", "kb", "LICENSE", "NOTICE", "README.md"],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepack": "node ../../scripts/copy-kb.mjs cli"
  },
  "dependencies": {
    "oxc-parser": "^0.148.0"
  },
  "devDependencies": {
    "@egressa/core": "workspace:^",
    "@egressa/kb": "workspace:^",
    "citty": "^0.1.6",
    "tsup": "^8.5.1",
    "yaml": "^2.6.1"
  }
}
