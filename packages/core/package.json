{
  "name": "@egressa/core",
  "version": "0.2.0",
  "description": "Engine for Egressa: detects third-party data-egress patterns in source code and their cross-border transfer exposure.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/J18Bharati/egressa.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/J18Bharati/egressa#readme",
  "bugs": {
    "url": "https://github.com/J18Bharati/egressa/issues"
  },
  "keywords": [
    "gdpr",
    "privacy",
    "data-protection",
    "data-transfer",
    "cross-border",
    "static-analysis"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "!dist/**/*.map", "LICENSE", "NOTICE", "README.md"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepack": "node ../../scripts/copy-kb.mjs core"
  },
  "dependencies": {
    "@egressa/kb": "workspace:^",
    "ignore": "^7.0.8",
    "jsonc-parser": "^3.3.1",
    "oxc-parser": "^0.148.0",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
