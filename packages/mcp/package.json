{
  "name": "@egressa/mcp",
  "version": "0.2.0",
  "description": "MCP server exposing Egressa transfer-exposure scanning and vendor lookups.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egressa-dev/egressa.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/egressa-dev/egressa#readme",
  "bugs": {
    "url": "https://github.com/egressa-dev/egressa/issues"
  },
  "keywords": [
    "gdpr",
    "privacy",
    "data-protection",
