    "euRegion": {
      "available": true,
      "scope": "full",
      "docUrl": "https://aws.amazon.com/compliance/data-privacy-faq/",
      "notes": "AWS publishes Regions in Ireland, Frankfurt, Paris, Stockholm, Milan, Spain and the AWS European Sovereign Cloud in Germany, and states that customer content is not moved out of the selected Region except as the customer directs. Scope is recorded as full because the Region setting governs where customer content is stored for the services that offer it; it does not follow that every operational record, account record or support interaction stays in the Region, and the pages checked do not state that they do."
